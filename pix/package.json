{
  "name": "pix-read",
  "version": "0.1.0",
  "description": "PiX-Read - AI reading workspace",
  "type": "module",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && node scripts/dev-electron.mjs\"",
    "dev:renderer": "vite",
    "dev:electron": "electron .",
    "build:renderer": "vite build",
    "build:main": "shx rm -rf dist/main && tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && shx mv dist/preload-tmp/main/preload.js dist/main/main/preload.cjs && shx rm -rf dist/preload-tmp && node scripts/assert-main-esm.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "check": "vue-tsc --noEmit -p tsconfig.json && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "smoke:notes": "node scripts/smoke-notes.mjs",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "file:../packages/agent",
    "@earendil-works/pi-ai": "file:../packages/ai",
    "@earendil-works/pi-coding-agent": "file:../packages/coding-agent",
    "@mdi/font": "^7.4.47",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "get-east-asian-width": "1.6.0",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "pdfjs-dist": "4.10.38",
    "pi-mcp-adapter": "file:../packages/mcp-adapter",
    "pinia": "^2.1.0",
    "typebox": "1.1.38",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "vuetify": "^3.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "5.8.3",
    "vite": "^5.4.0",
    "vue-tsc": "2.1.6",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pixread.app",
    "productName": "PiX-Read",
    "publish": null,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "index.html",
      "resources/skills/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/skills",
        "to": "skills"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PiX-Read",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
